{
  "name": "wiki",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run gen && ng serve",
    "build": "ng build",
    "build:prod": "npm run gen && ng build --configuration production",
    "gen": "npm run gen:guides && npm run gen:circuits && npm run gen:manifest && npm run gen:sitemap",
    "gen:guides": "node scripts/gen-guides.mjs",
    "gen:circuits": "tsx scripts/gen-circuits.ts",
    "gen:manifest": "node scripts/gen-data-manifest.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm run lint:contrast && npm run typecheck:scripts",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.5",
    "@angular/router": "^22.1.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/ssr": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.9.0",
    "jsdom": "^30.0.1",
    "marked": "^18.0.12",
    "prettier": "^3.8.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
