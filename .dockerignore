# This file governs what crosses to the Docker daemon, and nothing more.
#
# What reaches the IMAGE is decided in docker/Dockerfile, which names its build
# inputs explicitly rather than copying the tree. So this list does not have to
# be exhaustive, and should not be treated as a security boundary: a file
# missing from here is a slower build, not a file in the image. That division
# is deliberate -- the deny-list had already drifted (.idea and .ruff_cache
# were never added) which is precisely why the Dockerfile stopped relying on it.
#
# tools/ carries the extraction pipeline, its virtualenv and ~45 MB of IL2CPP
# dump; keeping that out of the transfer is the single biggest win here.
tools
.venv
.git
.github
docs
.serena
.superpowers

# Everything the build stage would only have to delete or rebuild.
node_modules
dist
.angular

# Local tooling output.
.vscode
*.log
npm-debug.log*

# Tests do not run in the image build; CI runs them against the same source.
**/*.spec.ts

# Not source. Note this excludes docker/Dockerfile specifically and not the
# whole docker/ directory: the runtime stage COPYs docker/nginx.conf out of the
# context, so excluding the directory would break the build.
docker/Dockerfile
.dockerignore
