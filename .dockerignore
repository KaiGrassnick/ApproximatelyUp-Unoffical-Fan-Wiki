# The build context is the repo root, so the first job is excluding
# everything that is not the wiki. tools/ carries the extraction pipeline,
# its virtualenv and ~45 MB of IL2CPP dump; none of it reaches the image.
tools
.venv
.git
.github
docs
.serena
.superpowers

# Everything the build stage would only have to delete or rebuild.
node_modules
dist
.angular

# Local tooling output.
.vscode
*.log
npm-debug.log*

# Tests do not run in the image build; CI runs them against the same source.
**/*.spec.ts

# Not source. Note this excludes docker/Dockerfile specifically and not the
# whole docker/ directory: the runtime stage COPYs docker/nginx.conf out of the
# context, so excluding the directory would break the build.
docker/Dockerfile
.dockerignore
