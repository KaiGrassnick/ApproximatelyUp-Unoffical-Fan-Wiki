# Copy this file to tools/.env and adjust the paths for your machine.
# From the repo root:
#   copy tools\.env.template tools\.env   (Windows)
#   cp   tools/.env.template tools/.env    (bash)
#
# tools/.env is gitignored — these locations are per-machine and must not be
# committed. Anything already set in the real environment wins over this file,
# and both win over the built-in defaults shown below.
#
# You only need these to RE-EXTRACT from the game. Running the wiki itself
# needs no game files at all: data/ is committed, so
# `cd web && npm ci && npm start` works on a machine without the game.

# The folder containing GameAssembly.dll and ApproximatelyUp_Data\.
# Default: C:\Program Files (x86)\Steam\steamapps\common\Approximately Up
# A second Steam library looks more like the example below.
APPROXIMATELY_UP_GAME=C:\Program Files (x86)\Steam\steamapps\common\Approximately Up

# The save folder, containing Worlds\<id>.world.
# Only Worlds\ is ever read — not blueprints, not General\*.sav.
# Leave unset unless your saves are somewhere unusual.
# Default: %USERPROFILE%\AppData\LocalLow\ApproximatelyGames\ApproximatelyUp
APPROXIMATELY_UP_SAVES=%USERPROFILE%\AppData\LocalLow\ApproximatelyGames\ApproximatelyUp
